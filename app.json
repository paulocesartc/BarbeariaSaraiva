{
  "expo": {
    "name": "Barbearia Saraiva",
    "slug": "barbearia-saraiva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barbeariasaraiva.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.barbeariasaraiva.app",
      "jsEngine": "hermes",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["android.permission.READ_CONTACTS"]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "react-native-edge-to-edge",
        { "android": { "parentTheme": "Edge" } }
      ],
      "expo-sqlite",
      [
        "expo-contacts",
        { "contactsPermission": "O app precisa acessar seus contatos para importação." }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4b851623-c57f-4d11-b7dc-5d7ebca2b50e"
      }
    }
  }
}
